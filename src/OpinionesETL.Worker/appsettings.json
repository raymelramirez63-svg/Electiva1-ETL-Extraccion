{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Extraction": {
    "StagingDirectory": "Staging",
    "MaxParallelSources": 3,
    "CsvSources": [
      { "Name": "encuestas", "Path": "Data/surveys_part1.csv", "Enabled": true },
      { "Name": "clientes", "Path": "Data/clients.csv", "Enabled": true },
      { "Name": "productos", "Path": "Data/products.csv", "Enabled": true },
      { "Name": "fuentes", "Path": "Data/fuente_datos.csv", "Enabled": true }
    ],
    "Database": { "Name": "resenas_sql", "Enabled": true },
    "Api": {
      "Name": "comentarios_api",
      "Enabled": true,
      "BaseUrl": "http://localhost:5075/",
      "PageSize": 100,
      "MaxPages": 100,
      "TimeoutSeconds": 30
    }
  }
}
